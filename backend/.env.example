# Required in production (Heroku sets DATABASE_URL). Local dev defaults to sqlite if unset.
# DATABASE_URL=postgresql://user:pass@host/dbname

# Optional: default 5000. Heroku sets PORT.
# PORT=5000

# development | production
# FLASK_ENV=development

# Dev only: set to 1 to disable SSL verification for outbound HTTP/Spotify (e.g. corporate proxy).
# Only takes effect when FLASK_ENV=development. NEVER set in production.
# DISABLE_SSL_VERIFY=0

# Spotify (required for playlist creation)
CLIENT_ID=your_spotify_client_id
CLIENT_SECRET=your_spotify_client_secret
REDIRECT_URI=http://localhost:3000
